{
  "name": "sinc",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace @sinc/server",
    "dev:mobile": "npm run start --workspace @sinc/mobile",
    "test": "npm run test --workspace @sinc/shared",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace @sinc/server",
    "postinstall": "npm run prisma:generate --workspace @sinc/server"
  },
  "engines": {
    "node": ">=22.13"
  }
}
